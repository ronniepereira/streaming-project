generator client {
    provider    = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Video {
    id        String   @id
    title     String
    description  String
    url  String
    sizeInKb Int
    thumbnailUrl String?
    videoUrl String
    duration Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}